# ---------- 基本信息 ----------
# 容器名前缀，同时是 Traefik router / service 名；同一台机器部署第二套时改成别的名字
APP_NAME=dujiao-next
# 商城域名（不带协议和路径）。灰云 A 记录指内网 IP 走 websecure；橙云 CNAME 指隧道走 web-cf
APP_DOMAIN=shop.example.com
# 镜像仓库。默认官方镜像；用 custom 分支自建的镜像时改成自己的仓库地址（如 ghcr.io/<用户名>/<镜像名>）
IMAGE_REPO=dujiaonext/dujiao-next
# 镜像 tag。写具体版本可回滚；官方镜像改成 latest 每次 Deploy 自动跟进
IMAGE_TAG=v1.4.7
# Redis 官方镜像 tag
REDIS_IMAGE_TAG=8.8.2-alpine

# 验证器（2FA）里显示的发行方名称，管理员和顾客都会看到；不要含 & 等特殊字符
TOTP_ISSUER=MyShop

# ---------- 路由与反向代理 ----------
# 后台入口路径：以 / 开头、不以 / 结尾，不能是 /api、/uploads、/health 或它们的上下级；
# 每段只允许字母、数字、- . _ ~ @。必须改掉默认的 /admin
ADMIN_PATH=/dj-mgmt-7x9k2
# 允许改写客户端 IP 的反向代理网段 = traefik-net 的子网，多个用逗号分隔；禁止 0.0.0.0/0（会拒绝启动）
# 必须改：宿主机执行 docker network inspect traefik-net -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.18.0.0/16

# ---------- 抢救通道（不经 DNS 和 Traefik 直连 http://HOST_IP:HOST_PORT） ----------
# 必须改：填 NAS / Dokploy 宿主机的内网 IP。只绑这个地址；宿主机上没有这个 IP 时容器起不来
HOST_IP=192.168.1.10
# 宿主机端口，部署前 ss -tulnp 确认没被占用
HOST_PORT=18080

# ---------- 密钥（必须改：三把互不相同、各不少于 32 字符，不能含 change-me 字样） ----------
# 生成方法：openssl rand -hex 32，执行三次分别填入
# 通用加密密钥：AES-256 加密数据库里的支付网关密钥、SMTP 密码等。上线后不能再换，丢了这些配置全部作废
APP_SECRET_KEY=7868b758d00f0fef34325cd35f13a8d313447d7cf14ff51468ddde76d2a9775e
# 后台登录 JWT 签名密钥；换掉只会让所有管理员重新登录
JWT_SECRET=b3a60c6254c58efdfaa3680f610180a63048082f26633931a7fff2c2bcbdb0f6
# 前台用户 JWT 签名密钥；换掉只会让所有用户重新登录
USER_JWT_SECRET=6d2429ecd204ca610775458dd6d8f6b4e9865a938fa59b7d88c41d67532cb3ec
# Redis 密码，只在项目内部网络使用。用十六进制，避免 $ 这类会被 compose 当变量插值的字符
REDIS_PASSWORD=0ccd331cda63362223d8b99a5f11b34a

# ---------- 首次启动创建的超级管理员（只在管理员表为空时生效） ----------
ADMIN_USERNAME=admin
# 必须改：至少 8 位，含大写、小写和数字；不能是 admin / password 等常见值。登录成功后可以清空再 Redeploy
ADMIN_PASSWORD=DjAdmin2026x

# ---------- 出网代理（留空不生效） ----------
# 支付网关回调查询、Telegram Bot、SMTP、上游库存同步、版本检查都会走它
PROXY_URL=
NO_PROXY_LIST=localhost,127.0.0.1,::1
